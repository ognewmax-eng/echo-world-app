{
	"nodes": [
		{
			"id": "5206c8a9f7f68ad8",
			"type": "group",
			"x": 0,
			"y": 0,
			"width": 700,
			"height": 260,
			"label": "Мир"
		},
		{
			"id": "a95dcb8aebb202ef",
			"type": "text",
			"text": "# Город туманов\nПортовый город, где туман приходит каждый вечер и уносит звуки. Жители зажигают маяки не для кораблей, а чтобы не забыть дорогу домой.",
			"x": 20,
			"y": 40,
			"width": 320,
			"height": 200
		},
		{
			"id": "62d7d5184b7a313d",
			"type": "text",
			"text": "# Тон истории\nУютно, неторопливо, с сухим юмором. Без кровавых сцен. #ии",
			"x": 360,
			"y": 40,
			"width": 320,
			"height": 200
		},
		{
			"id": "164cfac4896bfe93",
			"type": "group",
			"x": 740,
			"y": 0,
			"width": 360,
			"height": 260,
			"label": "Начало"
		},
		{
			"id": "f1584b995a477098",
			"type": "text",
			"text": "Вечер. Мира поднимается на старый маяк и видит, что его огонь кто-то уже зажёг.",
			"x": 760,
			"y": 40,
			"width": 320,
			"height": 200
		},
		{
			"id": "017495ba9dbe8d02",
			"type": "group",
			"x": 0,
			"y": 300,
			"width": 360,
			"height": 260,
			"label": "Главный герой",
			"color": "1"
		},
		{
			"id": "346b81a32e7007ec",
			"type": "text",
			"text": "# Мира\nСмотритель маяка, 27 лет. Наблюдательная, упрямая, не любит просить о помощи.",
			"x": 20,
			"y": 340,
			"width": 320,
			"height": 200
		},
		{
			"id": "85b6f10bfbcce227",
			"type": "group",
			"x": 400,
			"y": 300,
			"width": 700,
			"height": 260,
			"label": "Персонажи",
			"color": "1"
		},
		{
			"id": "a9f7e97965d6cf79",
			"type": "text",
			"text": "# Тимофей\nСтарый лодочник, знает всех в порту и ничего не рассказывает даром.",
			"x": 420,
			"y": 340,
			"width": 320,
			"height": 200
		},
		{
			"id": "9ab62b5ef34a9854",
			"type": "text",
			"text": "# Кот Штиль\nЖивёт на маяке, появляется там, где что-то не так.",
			"x": 760,
			"y": 340,
			"width": 320,
			"height": 200
		},
		{
			"id": "43442cb8a2fc8193",
			"type": "group",
			"x": 0,
			"y": 600,
			"width": 360,
			"height": 260,
			"label": "Места",
			"color": "5"
		},
		{
			"id": "ec6ef230f1828039",
			"type": "text",
			"text": "# Старый маяк\nВинтовая лестница на 212 ступеней, наверху — линза размером с лодку.",
			"x": 20,
			"y": 640,
			"width": 320,
			"height": 200
		},
		{
			"id": "f340d0aef6658784",
			"type": "group",
			"x": 400,
			"y": 600,
			"width": 360,
			"height": 260,
			"label": "Правила мира",
			"color": "4"
		},
		{
			"id": "7c92cf1eee8d99cc",
			"type": "text",
			"text": "Туман забирает звуки, но не свет: в тумане слышно только того, кто держит огонь.",
			"x": 420,
			"y": 640,
			"width": 320,
			"height": 200
		},
		{
			"id": "29fd010b67854cb0",
			"type": "group",
			"x": 800,
			"y": 600,
			"width": 360,
			"height": 260,
			"label": "Силы и фракции",
			"color": "6"
		},
		{
			"id": "bd19836ddb62c11c",
			"type": "text",
			"text": "# Гильдия смотрителей\nСледит за маяками города. Не любит, когда огни зажигают без её ведома.",
			"x": 820,
			"y": 640,
			"width": 320,
			"height": 200
		},
		{
			"id": "2ed76a355243b41f",
			"type": "group",
			"x": 0,
			"y": 900,
			"width": 1100,
			"height": 260,
			"label": "Повороты сюжета",
			"color": "2"
		},
		{
			"id": "edbab45572c72a5d",
			"type": "text",
			"text": "# Чужой огонь\nМира находит маяк уже зажжённым и следы на лестнице.",
			"x": 20,
			"y": 940,
			"width": 320,
			"height": 200
		},
		{
			"id": "fbfba2e45c2045dc",
			"type": "text",
			"text": "# Гильдия приходит\nГильдия обвиняет Миру в нарушении правил.",
			"x": 380,
			"y": 940,
			"width": 320,
			"height": 200
		},
		{
			"id": "7a6f150b83091ce2",
			"type": "text",
			"text": "# Тот, кто держит огонь\nМира узнаёт, кто зажигает маяк и зачем.",
			"x": 740,
			"y": 940,
			"width": 320,
			"height": 200
		},
		{
			"id": "44500a48255cb54f",
			"type": "group",
			"x": 0,
			"y": 1200,
			"width": 360,
			"height": 260,
			"label": "Развитие персонажей",
			"color": "3"
		},
		{
			"id": "8a8bb7cd343aa2ad",
			"type": "text",
			"text": "# Мира\nОт «справлюсь сама» — к тому, чтобы впервые попросить о помощи.",
			"x": 20,
			"y": 1240,
			"width": 320,
			"height": 200
		},
		{
			"id": "3d62d96202de4091",
			"type": "group",
			"x": 400,
			"y": 1200,
			"width": 360,
			"height": 260,
			"label": "Тайны и линии"
		},
		{
			"id": "83f1535f99ab0bf4",
			"type": "text",
			"text": "Кто зажигает старый маяк по вечерам?",
			"x": 420,
			"y": 1240,
			"width": 320,
			"height": 200
		}
	],
